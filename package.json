{
  "name": "@antho686/nodejs-commons",
  "version": "0.1.0",
  "description": "Shared utility modules for Node.js scripts and applications",
  "keywords": [
    "utils",
    "utility",
    "helpers",
    "nodejs",
    "javascript",
    "toolkit",
    "shared",
    "common",
    "library",
    "node",
    "commonjs",
    "module",
    "esm"
  ],
  "homepage": "https://github.com/antho686/nodejs-commons#readme",
  "bugs": {
    "url": "https://github.com/antho686/nodejs-commons/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antho686/nodejs-commons.git"
  },
  "license": "MIT",
  "author": "antho686",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    }
  },
  "scripts": {
    "test": "jest --config ./jest.config.js --passWithNoTests",
    "build": "npm run build:cjs && npm run build:mjs && npm run build:types",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:mjs": "tsc -p tsconfig.mjs.json",
    "build:types": "tsc -p tsconfig.types.json",
    "clean": "npm run clean:dist && npm run clean:cov && npm run clean:mod",
    "clean:dist": "rimraf dist",
    "clean:types": "rimraf dist/types",
    "clean:cjs": "rimraf dist/cjs",
    "clean:mjs": "rimraf dist/esm",
    "clean:cov": "rimraf coverage",
    "clean:mod": "rimraf node_modules"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "jest": "^30.5.1",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  }
}
